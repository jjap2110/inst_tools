<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Conductividad eléctrica de H₂SO₄ concentrado — OAPSA">
<title>Conductividad H₂SO₄ · OAPSA</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Roboto+Mono:wght@400;500;600&display=swap');

*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#020B1F;--surface:#08132D;--surface2:#0D1B3A;
  --text:#E8ECF0;--text2:#B0BEC5;--text3:#8A9BB5;
  --border:rgba(0,242,255,0.15);--border2:rgba(0,242,255,0.25);
  --radius:8px;
  --acc:#00CFFF;--acc-bg:#061E3F;--acc-text:#00CFFF;
  --ok:#00E676;--ok-bg:#062E1A;--ok-text:#00E676;
  --warn:#FFB300;--warn-bg:#2A1F00;--warn-text:#FFD54F;
  --danger:#FF5252;--danger-bg:#2D0A0A;--danger-text:#FF8A80;
}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
     background:var(--bg);color:var(--text);font-size:15px;line-height:1.5;min-height:100vh}
.app{max-width:480px;margin:0 auto;padding:16px 14px 40px}
h1{font-size:18px;font-weight:600;color:var(--text);margin-bottom:2px}
.subtitle{font-size:12px;color:var(--text3);margin-bottom:16px}
.section-label{font-size:11px;font-weight:600;color:var(--text3);
               text-transform:uppercase;letter-spacing:.05em;margin:14px 0 8px}
.card{background:var(--surface);border:1px solid var(--border);
      border-radius:12px;padding:14px;margin-bottom:14px}

/* Hero */
.hero{background:var(--acc-bg);border:1px solid var(--border2);
      border-radius:12px;padding:16px 18px;color:var(--text);
      text-align:center;margin-bottom:10px}
.hero .lbl{font-size:11px;text-transform:uppercase;letter-spacing:1px;
           opacity:.9;font-weight:600;color:var(--text3)}
.hero .big{font-size:38px;font-weight:800;line-height:1.1;
           margin-top:3px;color:var(--text)}
.hero .big .u{font-size:16px;font-weight:600;opacity:.9}
.hero .sub2{font-size:13px;opacity:.85;margin-top:3px;color:var(--text2)}

/* OOR */
.oor{background:var(--warn-bg);border:1px solid rgba(255,179,0,.3);
     color:var(--warn-text);font-size:12px;border-radius:var(--radius);
     padding:8px 11px;margin-bottom:8px;display:none}
.oor.show{display:block}

/* Boxes */
.grid{display:flex;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.box{flex:1 1 0;min-width:90px;background:var(--surface2);
     border-radius:var(--radius);padding:10px 12px;text-align:center}
.box .bl{font-size:10px;text-transform:uppercase;letter-spacing:.5px;
         color:var(--text3);font-weight:600}
.box .bv{font-size:22px;font-weight:700;color:var(--text);
         line-height:1.1;margin-top:2px}
.box .bu{font-size:11px;color:var(--text3)}

/* Sliders */
.srow{margin-bottom:8px}
.srow .sl{font-size:11px;color:var(--text3);font-weight:600;
          margin-bottom:3px;display:flex;justify-content:space-between}
.srow .si{display:flex;align-items:center;gap:10px}
input[type=range]{-webkit-appearance:none;appearance:none;flex:1;
                  height:7px;border-radius:var(--radius);outline:none;margin:6px 0}
.srow.temp input[type=range]{background:linear-gradient(90deg,var(--acc),var(--danger))}
.srow.conc input[type=range]{background:linear-gradient(90deg,var(--ok),var(--acc))}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:24px;height:24px;
  border-radius:50%;background:var(--bg);border:3px solid var(--acc);
  cursor:pointer;box-shadow:0 0 8px rgba(0,207,255,.3)}
input[type=range]::-moz-range-thumb{width:24px;height:24px;border-radius:50%;
  background:var(--bg);border:3px solid var(--acc);cursor:pointer}
input[type=number]{width:76px;font-size:14px;padding:5px 6px;
  border:1px solid var(--border2);border-radius:var(--radius);
  text-align:center;color:var(--text);font-weight:700;
  background:var(--surface2);font-family:'Roboto Mono',monospace}
.ticks{display:flex;justify-content:space-between;font-size:10px;
       color:var(--text3);margin-top:1px}

/* Chart */
svg.chart{width:100%;height:auto;display:block;margin:10px 0 4px}

/* Derived */
.derived{font-size:12px;color:var(--text2);margin-top:6px}
.derived b{color:var(--text)}
.note{font-size:11px;color:var(--text3);font-style:italic;margin-top:12px;
      line-height:1.4;border-top:1px solid var(--border);padding-top:10px}

/* Disclaimer collapsible */
.alerts-toggle{display:flex;align-items:center;gap:6px;font-size:12px;
               color:var(--text3);cursor:pointer;padding:4px 0;margin-top:6px;
               user-select:none;background:none;border:none;
               font-family:inherit;width:100%;text-align:left}
.alerts-toggle:hover{color:var(--text2)}
.alerts-toggle .toggle-icon{font-size:10px;transition:transform .2s}
.alerts-toggle.open .toggle-icon{transform:rotate(90deg)}
.disclaimer{background:var(--surface);border:1px solid var(--border);
            border-radius:12px;padding:14px;margin-top:14px;
            font-size:11px;color:var(--text3);line-height:1.6}
.disclaimer b{color:var(--text2)}
.eq-block{margin-top:8px;padding:8px 10px;background:var(--surface2);
          border-radius:var(--radius);font-family:'Roboto Mono',monospace;
          font-size:11px;line-height:1.8;color:var(--text2)}
.warn-block{margin-top:8px;padding:8px 10px;background:var(--danger-bg);
            border-radius:var(--radius);color:var(--danger-text);
            font-size:11px;line-height:1.5}
</style>
</head>
<body>
<noscript><div style="padding:20px;text-align:center;color:#E8ECF0;font-family:sans-serif">Esta herramienta requiere JavaScript habilitado para funcionar.</div></noscript>

<div class="app">
  <h1>Conductividad H₂SO₄</h1>
  <p class="subtitle">Ácido sulfúrico concentrado · Modelo polinomial 2D normalizado · R² = 0.9994</p>
  <p style="font-size:11px;color:var(--text3);margin:-12px 0 16px;opacity:0.7">
    por <b>Josmar Angulo</b> · <a href="https://wa.me/595991312920" style="color:var(--acc);text-decoration:none">Contacto</a>
  </p>

  <div class="section-label">Calculadora</div>
  <div class="card">

    <!-- Hero resultado -->
    <div class="hero">
      <div class="lbl">Conductividad calculada</div>
      <div class="big"><span id="kv">--</span> <span class="u">mS/cm</span></div>
      <div class="sub2" id="sub2"></div>
    </div>

    <!-- Advertencia extrapolación -->
    <div class="oor" id="oor">⚠ C = 95% está fuera del rango de ajuste (96–100%). Valor extrapolado.</div>

    <!-- Boxes -->
    <div class="grid">
      <div class="box">
        <div class="bl">Temperatura</div>
        <div class="bv"><span id="tv">55</span></div>
        <div class="bu">°C</div>
      </div>
      <div class="box">
        <div class="bl">Concentración</div>
        <div class="bv"><span id="cv">98</span></div>
        <div class="bu">% w/w</div>
      </div>
      <div class="box">
        <div class="bl">RMSE</div>
        <div class="bv">2.49</div>
        <div class="bu">mS/cm</div>
      </div>
    </div>

    <!-- Slider temperatura -->
    <div class="srow temp">
      <div class="sl">
        <span>Temperatura (°C)</span>
        <span style="font-weight:400;font-size:10px">rango ajuste: 20–90 °C</span>
      </div>
      <div class="si">
        <input type="range" id="ts" min="20" max="90" step="0.5" value="55">
        <input type="number" id="tn" min="20" max="90" step="0.5" value="55.0">
      </div>
      <div class="ticks"><span>20</span><span>38</span><span>55</span><span>73</span><span>90</span></div>
    </div>

    <!-- Slider concentración -->
    <div class="srow conc">
      <div class="sl">
        <span>Concentración H₂SO₄ (% w/w)</span>
        <span style="font-weight:400;font-size:10px">datos: 96–100%</span>
      </div>
      <div class="si">
        <input type="range" id="cs" min="95" max="100" step="0.1" value="98">
        <input type="number" id="cn" min="95" max="100" step="0.1" value="98.0">
      </div>
      <div class="ticks"><span>95</span><span>96</span><span>97</span><span>98</span><span>99</span><span>100</span></div>
    </div>

    <!-- Gráfico SVG -->
    <svg class="chart" id="svg-chart" viewBox="0 0 600 240" preserveAspectRatio="xMidYMid meet"></svg>

    <!-- Sensibilidades -->
    <div class="derived" id="derived"></div>

    <div class="note">
      Polinomio grado 3 normalizado a [−1,1] · 8 T × 5 C = 40 puntos ·
      Rango: T ∈ [20–90] °C, C ∈ [96–100] % w/w · Nº condición = 7.88
    </div>
  </div>

  <!-- Disclaimer -->
  <div>
    <button class="alerts-toggle" id="disc-toggle" onclick="toggleDisc()">
      <span class="toggle-icon">▶</span>
      <span>ℹ Modelo matemático y ecuaciones</span>
    </button>
    <div id="disc-body" style="display:none">
      <div class="disclaimer">
        <div style="font-size:12px;color:var(--text);line-height:1.7;margin-bottom:10px">
          Herramienta de <b>desarrollo personal</b>, sin vinculación con ningún fabricante.
          Cubre la región 96–100% w/w donde la conductividad cae con la concentración
          y sube con la temperatura (menor disociación iónica a alta concentración).
        </div>
        <div class="eq-block">
— Variables normalizadas —<br>
Tn = 2·(T − 20) / (90 − 20) − 1<br>
Cn = 2·(C − 96) / (100 − 96) − 1<br><br>
— Polinomio grado 3 · K(Tn,Cn) = Σ aᵢⱼ·Tnⁱ·Cnʲ —<br>
a₀₀ = +172.2161  a₀₁ = −84.1271   a₁₀ = +107.3519<br>
a₀₂ = −47.1071   a₁₁ = −56.4750   a₂₀ = +11.1708<br>
a₀₃ = −13.9167   a₁₂ = −26.8690   a₂₁ = −7.0438<br>
a₃₀ = −3.3780<br><br>
R² = 0.9994 · RMSE = 2.49 mS/cm · Nº cond = 7.88
        </div>
        <div class="warn-block" style="margin-top:12px">
          ⚠ <b>Solo para fines educativos e informativos.</b>
          Para aplicaciones de control de calidad o procesos críticos,
          valide con instrumentación calibrada en campo.
        </div>
      </div>
    </div>
  </div>

  <div style="margin-top:20px;text-align:center;font-size:11px;color:var(--text3)">
    <a href="index.html" style="color:var(--acc);text-decoration:none">← Volver al inicio</a>
  </div>
</div>

<script>
// ── MODELO ──────────────────────────────────────────────────
var T_MIN=20, T_MAX=90, C_MIN=96, C_MAX=100;
var COEF=[172.2160714286,-84.1270833333,107.3519480519,-47.1071428571,
          -56.475,11.1708333333,-13.9166666667,-26.869047619,-7.04375,-3.378030303];

function conductividad(T,C){
  var Tn=2*(T-T_MIN)/(T_MAX-T_MIN)-1;
  var Cn=2*(C-C_MIN)/(C_MAX-C_MIN)-1;
  var t=[1,Cn,Tn,Cn*Cn,Tn*Cn,Tn*Tn,Cn*Cn*Cn,Tn*Cn*Cn,Tn*Tn*Cn,Tn*Tn*Tn];
  var s=0; for(var i=0;i<COEF.length;i++) s+=COEF[i]*t[i];
  return s;
}

// ── ESTADO ──────────────────────────────────────────────────
var stateT=55, stateC=98;

// ── CURVAS DEL GRÁFICO ──────────────────────────────────────
var CURVES=[
  {c:96,color:'#00CFFF'},
  {c:97,color:'#00B4D8'},
  {c:98,color:'#0096C7'},
  {c:99,color:'#0077B6'},
  {c:100,color:'#4895EF'}
];

// ── GRÁFICO SVG ─────────────────────────────────────────────
function drawChart(){
  var svg=document.getElementById('svg-chart');
  svg.innerHTML='';
  var W=600,H=240,ml=48,mr=12,mt=12,mb=28;

  function el(tag,attrs){
    var e=document.createElementNS('http://www.w3.org/2000/svg',tag);
    for(var k in attrs) e.setAttribute(k,attrs[k]);
    return e;
  }

  var px=function(T){return ml+(T-T_MIN)/(T_MAX-T_MIN)*(W-ml-mr);};
  var py=function(K){return mt+(420-K)/420*(H-mt-mb);};

  // Clip
  var defs=el('defs',{});
  var cp=el('clipPath',{id:'clipK'});
  cp.appendChild(el('rect',{x:ml,y:mt,width:W-ml-mr,height:H-mt-mb}));
  defs.appendChild(cp); svg.appendChild(defs);

  // Grid horizontal
  [0,100,200,300,400].forEach(function(K){
    svg.appendChild(el('line',{x1:ml,y1:py(K),x2:W-mr,y2:py(K),
      stroke:'#0A2E5B','stroke-width':1}));
    var t=el('text',{x:ml-5,y:py(K)+4,'text-anchor':'end',
      'font-size':10,fill:'#8A9BB5','font-family':'Inter'});
    t.textContent=K; svg.appendChild(t);
  });

  // Ticks eje X
  [20,35,50,65,80,90].forEach(function(T){
    var t=el('text',{x:px(T),y:H-8,'text-anchor':'middle',
      'font-size':10,fill:'#8A9BB5','font-family':'Inter'});
    t.textContent=T; svg.appendChild(t);
  });

  // Labels ejes
  var xl=el('text',{x:(ml+W-mr)/2,y:H,'text-anchor':'middle',
    'font-size':10,fill:'#8A9BB5','font-family':'Inter','font-weight':'600'});
  xl.textContent='Temperatura (°C)'; svg.appendChild(xl);
  var yl=el('text',{x:10,y:H/2,'text-anchor':'middle',
    'font-size':10,fill:'#8A9BB5','font-family':'Inter',
    transform:'rotate(-90 10 '+H/2+')'});
  yl.textContent='Conductividad (mS/cm)'; svg.appendChild(yl);

  var g=el('g',{'clip-path':'url(#clipK)'});

  // Curva más cercana a stateC
  var nearest=CURVES.reduce(function(b,x){
    return Math.abs(x.c-stateC)<Math.abs(b.c-stateC)?x:b;
  });

  CURVES.forEach(function(cu){
    var d=''; var first=true;
    for(var T=T_MIN;T<=T_MAX;T+=1){
      var K=conductividad(T,cu.c);
      d+=(first?'M':'L')+px(T).toFixed(1)+' '+py(K).toFixed(1)+' ';
      first=false;
    }
    var isNearest=(cu.c===nearest.c);
    g.appendChild(el('path',{d:d,fill:'none',stroke:cu.color,
      'stroke-width':isNearest?3:1.5,
      'stroke-opacity':isNearest?1:0.4}));

    // Etiqueta al final de cada curva
    if(isNearest){
      var Kend=conductividad(T_MAX,cu.c);
      var lbl=el('text',{x:px(T_MAX)+4,y:py(Kend)+4,
        'font-size':9,fill:cu.color,'font-family':'Inter','font-weight':'600'});
      lbl.textContent=cu.c+'%';
      svg.appendChild(lbl);
    }
  });

  // Punto operativo
  var Kop=conductividad(stateT,stateC);
  var X=px(stateT), Y=py(Kop);
  g.appendChild(el('line',{x1:X,y1:mt,x2:X,y2:H-mb,
    stroke:'#FFB300','stroke-width':1,'stroke-dasharray':'4 3',opacity:.7}));
  g.appendChild(el('line',{x1:ml,y1:Y,x2:W-mr,y2:Y,
    stroke:'#FFB300','stroke-width':1,'stroke-dasharray':'4 3',opacity:.7}));
  g.appendChild(el('circle',{cx:X,cy:Y,r:6,fill:'#08132D',
    stroke:'#FFB300','stroke-width':2.5}));

  svg.appendChild(g);
}

// ── RENDER ──────────────────────────────────────────────────
function render(){
  var K=conductividad(stateT,stateC);
  var extrap=(stateC<C_MIN);

  document.getElementById('kv').textContent=K.toFixed(1);
  document.getElementById('tv').textContent=stateT.toFixed(1);
  document.getElementById('cv').textContent=stateC.toFixed(1);
  document.getElementById('oor').className='oor'+(extrap?' show':'');
  document.getElementById('sub2').textContent=
    extrap?'⚠ Extrapolación fuera del rango de ajuste':
    'T = '+stateT.toFixed(1)+' °C · C = '+stateC.toFixed(1)+' % w/w';

  // Derivadas numéricas con clamping en bordes
  var eps=0.05;
  var Ch=Math.min(C_MAX,stateC+eps);
  var Cl=stateC<C_MIN ? stateC-eps : Math.max(C_MIN,stateC-eps);
  var dKdC=(conductividad(stateT,Ch)-conductividad(stateT,Cl))/(Ch-Cl);
  var Th=Math.min(T_MAX,stateT+0.5);
  var Tl=Math.max(T_MIN,stateT-0.5);
  var dKdT=(conductividad(Th,stateC)-conductividad(Tl,stateC))/(Th-Tl);

  document.getElementById('derived').innerHTML=
    '&#8706;K/&#8706;C &#8776; <b>'+dKdC.toFixed(1)+'</b> mS/cm por % w/w &nbsp;&middot;&nbsp; '+
    '&#8706;K/&#8706;T &#8776; <b>'+dKdT.toFixed(2)+'</b> mS/cm por °C';

  drawChart();
}

// ── SLIDERS ─────────────────────────────────────────────────
function bindSlider(sid,nid,getter,setter,min,max){
  var s=document.getElementById(sid);
  var n=document.getElementById(nid);
  s.addEventListener('input',function(){
    var v=parseFloat(s.value);
    n.value=v.toFixed(1);
    setter(v); render();
  });
  n.addEventListener('input',function(){
    var v=parseFloat(n.value);
    if(isNaN(v)) return;
    v=Math.max(min,Math.min(max,v));
    s.value=v; n.value=v.toFixed(1);
    setter(v); render();
  });
}

bindSlider('ts','tn',
  function(){return stateT;},function(v){stateT=v;},20,90);
bindSlider('cs','cn',
  function(){return stateC;},function(v){stateC=v;},95,100);

// ── DISCLAIMER ──────────────────────────────────────────────
function toggleDisc(){
  var body=document.getElementById('disc-body');
  var btn=document.getElementById('disc-toggle');
  var open=body.style.display!=='none';
  body.style.display=open?'none':'block';
  btn.className=open?'alerts-toggle':'alerts-toggle open';
}

// ── INIT ────────────────────────────────────────────────────
render();
</script>
</body>
</html>
