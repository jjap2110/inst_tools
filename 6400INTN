<script>
function toggleSection(header) {
  const body = header.nextElementSibling;
  body.classList.toggle('hidden');
  header.classList.toggle('collapsed');
}

function selectOption(input) {
  const container = input.closest('.param-options');
  container.querySelectorAll('.radio-option').forEach(o => o.classList.remove('selected'));
  input.closest('.radio-option').classList.add('selected');
  updatePending();
}

function updatePending() {
  const fields = {
    'hazarea_sensor': '7. Certificación área clasificada',
    'config': '8. Configuración sensor-transmisor',
    'power': '15. Alimentación eléctrica',
    'hazarea_conv': '16. Certificación área clasificada del transmisor',
    'diag': '20. Diagnósticos de proceso',
    'housing': '21. Housing del convertidor'
  };
  const pending = [];
  for (const [name, label] of Object.entries(fields)) {
    const checked = document.querySelector(`input[name="${name}"]:checked`);
    if (!checked) pending.push(label);
  }
  const list = document.getElementById('pendingItems');
  const container = document.getElementById('pendingList');
  if (pending.length === 0) {
    container.querySelector('h4').textContent = '✓ Todas las decisiones completadas';
    list.innerHTML = '';
  } else {
    container.querySelector('h4').textContent = `Decisiones pendientes del cliente (${pending.length}):`;
    list.innerHTML = pending.map(p => `<li>${p}</li>`).join('');
  }
}
</script>
