<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Selección OPTIMASS 6400</title>
<style>
:root {
  --bg: #f8f9fa;
  --surface: #ffffff;
  --border: #dee2e6;
  --text: #212529;
  --text-muted: #6c757d;
  --accent: #0d6efd;
  --accent-light: #e7f1ff;
  --fixed-bg: #d1e7dd;
  --fixed-border: #a3cfbb;
  --fixed-text: #0f5132;
  --decide-bg: #fff3cd;
  --decide-border: #ffecb5;
  --decide-text: #664d03;
  --confirm-bg: #f8d7da;
  --confirm-border: #f5c2c7;
  --confirm-text: #842029;
  --note-bg: #cff4fc;
  --note-border: #b6effb;
  --note-text: #055160;
  --section-bg: #1a2332;
  --section-text: #ffffff;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #121820;
    --surface: #1a2332;
    --border: #2d3748;
    --text: #e2e8f0;
    --text-muted: #a0aec0;
    --accent: #63b3ed;
    --accent-light: #1a365d;
    --fixed-bg: #1a3a2a;
    --fixed-border: #2d6a4f;
    --fixed-text: #6ee7b7;
    --decide-bg: #3d2e00;
    --decide-border: #665000;
    --decide-text: #fcd34d;
    --confirm-bg: #3b1219;
    --confirm-border: #7f1d1d;
    --confirm-text: #fca5a5;
    --note-bg: #0c2d3a;
    --note-border: #155e75;
    --note-text: #67e8f9;
    --section-bg: #0f1724;
    --section-text: #e2e8f0;
  }
}
:root[data-theme="dark"] {
  --bg: #121820;
  --surface: #1a2332;
  --border: #2d3748;
  --text: #e2e8f0;
  --text-muted: #a0aec0;
  --accent: #63b3ed;
  --accent-light: #1a365d;
  --fixed-bg: #1a3a2a;
  --fixed-border: #2d6a4f;
  --fixed-text: #6ee7b7;
  --decide-bg: #3d2e00;
  --decide-border: #665000;
  --decide-text: #fcd34d;
  --confirm-bg: #3b1219;
  --confirm-border: #7f1d1d;
  --confirm-text: #fca5a5;
  --note-bg: #0c2d3a;
  --note-border: #155e75;
  --note-text: #67e8f9;
  --section-bg: #0f1724;
  --section-text: #e2e8f0;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  padding: 16px;
  max-width: 900px;
  margin: 0 auto;
}
.header {
  background: var(--section-bg);
  color: var(--section-text);
  border-radius: 12px;
  padding: 24px;
  margin-bottom: 20px;
}
.header h1 { font-size: 1.4rem; font-weight: 700; margin-bottom: 4px; }
.header .subtitle { font-size: 0.95rem; opacity: 0.85; margin-bottom: 16px; }
.header .ref-box {
  background: rgba(255,255,255,0.1);
  border-radius: 8px;
  padding: 12px 16px;
  font-size: 0.85rem;
  line-height: 1.7;
}
.header .ref-box strong { opacity: 0.7; }
.legend {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 20px;
  font-size: 0.8rem;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 6px;
}
.legend-fixed { background: var(--fixed-bg); color: var(--fixed-text); border: 1px solid var(--fixed-border); }
.legend-decide { background: var(--decide-bg); color: var(--decide-text); border: 1px solid var(--decide-border); }
.legend-confirm { background: var(--confirm-bg); color: var(--confirm-text); border: 1px solid var(--confirm-border); }
.section {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  margin-bottom: 16px;
  overflow: hidden;
}
.section-header {
  background: var(--section-bg);
  color: var(--section-text);
  padding: 14px 20px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  user-select: none;
}
.section-header:hover { opacity: 0.9; }
.section-header .arrow { transition: transform 0.2s; font-size: 0.8rem; }
.section-header.collapsed .arrow { transform: rotate(-90deg); }
.section-body { padding: 0; }
.section-body.hidden { display: none; }
.param {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
}
.param:last-child { border-bottom: none; }
.param-head {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.param-name { font-weight: 600; font-size: 0.95rem; }
.badge {
  font-size: 0.7rem;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  white-space: nowrap;
}
.badge-fixed { background: var(--fixed-bg); color: var(--fixed-text); border: 1px solid var(--fixed-border); }
.badge-decide { background: var(--decide-bg); color: var(--decide-text); border: 1px solid var(--decide-border); }
.badge-confirm { background: var(--confirm-bg); color: var(--confirm-text); border: 1px solid var(--confirm-border); }
.param-spec {
  font-size: 0.82rem;
  color: var(--text-muted);
  font-style: italic;
}
.param-spec::before { content: 'Requisito: '; font-weight: 600; font-style: normal; }
.param-value {
  background: var(--fixed-bg);
  color: var(--fixed-text);
  border: 1px solid var(--fixed-border);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 0.88rem;
  font-weight: 500;
}
.param-value::before { content: '✓ '; }
.param-options {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.radio-option {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 12px;
  border: 1px solid var(--border);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.15s;
  font-size: 0.88rem;
}
.radio-option:hover { border-color: var(--accent); background: var(--accent-light); }
.radio-option input { margin-top: 3px; accent-color: var(--accent); }
.radio-option.selected { border-color: var(--accent); background: var(--accent-light); }
.radio-label { flex: 1; }
.radio-label strong { display: block; }
.radio-label .radio-desc { font-size: 0.8rem; color: var(--text-muted); }
.note {
  background: var(--note-bg);
  color: var(--note-text);
  border: 1px solid var(--note-border);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 0.82rem;
}
.note::before { content: '⚠ '; font-weight: 700; }
.confirm-note {
  background: var(--confirm-bg);
  color: var(--confirm-text);
  border: 1px solid var(--confirm-border);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 0.82rem;
}
.confirm-note::before { content: '⚡ '; font-weight: 700; }
.summary-section {
  background: var(--surface);
  border: 2px solid var(--accent);
  border-radius: 12px;
  margin-top: 24px;
  overflow: hidden;
}
.summary-header {
  background: var(--accent);
  color: white;
  padding: 14px 20px;
  font-weight: 700;
  font-size: 1rem;
}
.summary-body { padding: 20px; }
.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin-bottom: 16px;
}
@media (max-width: 600px) { .summary-grid { grid-template-columns: 1fr; } }
.summary-card {
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px 16px;
}
.summary-card h4 { font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
.summary-card .val { font-weight: 600; font-size: 0.95rem; }
.pending-list {
  margin-top: 16px;
  padding: 16px;
  background: var(--decide-bg);
  border: 1px solid var(--decide-border);
  border-radius: 8px;
}
.pending-list h4 { color: var(--decide-text); margin-bottom: 8px; font-size: 0.9rem; }
.pending-list ul { padding-left: 20px; color: var(--decide-text); font-size: 0.85rem; }
.pending-list li { margin-bottom: 4px; }
.confirm-list {
  margin-top: 12px;
  padding: 16px;
  background: var(--confirm-bg);
  border: 1px solid var(--confirm-border);
  border-radius: 8px;
}
.confirm-list h4 { color: var(--confirm-text); margin-bottom: 8px; font-size: 0.9rem; }
.confirm-list ul { padding-left: 20px; color: var(--confirm-text); font-size: 0.85rem; }
.confirm-list li { margin-bottom: 4px; }
.footer {
  text-align: center;
  color: var(--text-muted);
  font-size: 0.75rem;
  margin-top: 24px;
  padding: 12px;
}
@media print {
  body { padding: 0; }
  .section-header { cursor: default; }
  .section-body.hidden { display: block !important; }
  .radio-option { break-inside: avoid; }
}
</style>
</head>
<body>

<div class="header">
  <h1>OPTIMASS 6400 — Guía de Selección Técnica</h1>
  <div class="subtitle">Patrón de Medición de Masa y Volumen para GLP · Clase 0.3 según OIML R 117-1</div>
  <div class="ref-box">
    <strong>Aplicación:</strong> Aprobación de Modelo y Verificación Inicial de sistemas Clase 1.0<br>
    <strong>Fluido:</strong> Gas Licuado de Petróleo (GLP) — Fase líquida, 500–600 kg/m³<br>
    <strong>Rango de caudal:</strong> 5 a 60 L/min (160 a 2,000 kg/h)<br>
    <strong>Condiciones:</strong> -10°C a +40°C · 5 a 15 bar · Diseño ANSI 300# (mín. 25 bar)<br>
    <strong>Normativa:</strong> OIML R 117-1 · ISO/IEC 17025 · ATEX/IECEx Zona 1, Grupo D, T4
  </div>
</div>

<div class="legend">
  <div class="legend-item legend-fixed">Definido por la especificación</div>
  <div class="legend-item legend-decide">Requiere decisión del cliente</div>
  <div class="legend-item legend-confirm">Confirmar con KROHNE</div>
</div>

<!-- ===== SENSOR ===== -->
<div class="section">
  <div class="section-header" onclick="toggleSection(this)">
    SENSOR — MFS 6000 (OPTIMASS 6400) <span class="arrow">▼</span>
  </div>
  <div class="section-body">

    <!-- Material -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">1. Material del Tubo Sensor</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">Tubos y cuerpo en Acero Inoxidable 316/316L. Sellos en Viton o PTFE.</div>
      <div class="param-value">S — Acero Inoxidable 316/316L Dual Certified</div>
    </div>

    <!-- Acabado -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">2. Acabado Superficial</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">No se requiere acabado sanitario ni higiénico para GLP.</div>
      <div class="param-value">0 — Estándar</div>
    </div>

    <!-- Conexión -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">3. Conexión de Proceso</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">Bridas tipo ANSI 300# RF (Cara levantada) bajo norma ASME B16.5.</div>
      <div class="param-value">ME — 1" ASME 300 lb (DN25 equivalente, sensor Size 15)</div>
    </div>

    <!-- Cara de sellado -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">4. Cara de Sellado</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">Cara levantada (RF) es el estándar para ASME B16.5 en servicio de GLP.</div>
      <div class="param-value">0 — Estándar (Raised Face)</div>
    </div>

    <!-- Diseño -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">5. Diseño del Sensor</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">Temperatura de operación -10°C a +40°C — dentro del rango Short Stem (-196°C a +150°C).</div>
      <div class="param-value">0 — Short Stem</div>
    </div>

    <!-- Opciones mecánicas -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">6. Opciones Mecánicas</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">No se requiere aislación ni calefacción para GLP a temperatura ambiente.</div>
      <div class="param-value">0 — Sin opciones adicionales</div>
    </div>

    <!-- Hazardous Area -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">7. Certificación para Área Clasificada</span>
        <span class="badge badge-decide">Decisión del cliente</span>
      </div>
      <div class="param-spec">Zona 1 (o Clase I, División 1), Grupo D, T4. Ex d o Ex i.</div>
      <div class="param-options" data-field="hazarea_sensor">
        <label class="radio-option">
          <input type="radio" name="hazarea_sensor" value="1-ATEX Ex ia (T1-T6)" onchange="selectOption(this)">
          <span class="radio-label"><strong>1 — ATEX Ex ia (T1-T6)</strong><span class="radio-desc">Estándar europeo. Ampliamente aceptado internacionalmente.</span></span>
        </label>
        <label class="radio-option">
          <input type="radio" name="hazarea_sensor" value="R-IECEx Ex ia (T1-T6)" onchange="selectOption(this)">
          <span class="radio-label"><strong>R — IECEx Ex ia (T1-T6)</strong><span class="radio-desc">Estándar internacional. Recomendado para Latinoamérica sin marco regulatorio ATEX propio.</span></span>
        </label>
      </div>
      <div class="note">La selección debe coincidir con el transmisor MFC 400. IECEx es la opción recomendada para Paraguay, salvo que el marco regulatorio local exija otra certificación.</div>
    </div>

    <!-- Configuración -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">8. Configuración Sensor-Transmisor</span>
        <span class="badge badge-decide">Decisión del cliente</span>
      </div>
      <div class="param-spec">Montado sobre estructura portátil (skid móvil) para traslado a estaciones de verificación.</div>
      <div class="param-options" data-field="config">
        <label class="radio-option">
          <input type="radio" name="config" value="0-Compacto/Integral (máx 230°C)" onchange="selectOption(this)">
          <span class="radio-label"><strong>0 — Compacto / Integral</strong><span class="radio-desc">Sensor y transmisor en una sola unidad. Ideal para skid portátil: menos cableado, más compacto, sin cable de señal remoto.</span></span>
        </label>
        <label class="radio-option">
          <input type="radio" name="config" value="1-Remoto con junction box Aluminio" onchange="selectOption(this)">
          <span class="radio-label"><strong>1 — Remoto, Junction Box Aluminio</strong><span class="radio-desc">Transmisor separado del sensor. Útil si el display debe estar alejado del punto de medición o en área no clasificada.</span></span>
        </label>
        <label class="radio-option">
          <input type="radio" name="config" value="2-Remoto con junction box Acero Inoxidable" onchange="selectOption(this)">
          <span class="radio-label"><strong>2 — Remoto, Junction Box Acero Inox</strong><span class="radio-desc">Igual que opción 1 pero con mayor resistencia a corrosión.</span></span>
        </label>
      </div>
    </div>

    <!-- Calibración -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">9. Calibración</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">Certificado ISO/IEC 17025, incertidumbre expandida (k=2) ≤ 0.06%, EMP ±0.2% en masa y volumen.</div>
      <div class="param-value">S — Calibración 0.05% flujo másico, 5 puntos + volumen acc. ISO 10790 + Certificado ISO/IEC 17025</div>
      <div class="confirm-note">Confirmar con KROHNE que la incertidumbre expandida (k=2) declarada en el certificado sea ≤ 0.06%. Con calibración base de 0.05%, debería ser alcanzable.</div>
    </div>

    <!-- Process Req -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">10. Requisitos de Proceso</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">GLP comercial a temperatura ambiente. No se requiere criogénico ni alta temperatura.</div>
      <div class="param-value">0 — Estándar</div>
    </div>

    <!-- Extended Options - OIML -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">11. Conformidad OIML R 117-1</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">Clase 0.3 según OIML R 117-1 para líquidos distintos al agua.</div>
      <div class="param-value">Z — acc. OIML R117-1 para líquidos distintos al agua</div>
    </div>

    <!-- Burst Disk -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">12. Disco de Ruptura</span>
        <span class="badge badge-confirm">Confirmar con KROHNE</span>
      </div>
      <div class="param-spec">Obligatorio para aplicaciones de gas licuado por encima de 10 barg. GLP opera entre 5 y 15 bar.</div>
      <div class="confirm-note">La opción G (Burst Disk) es obligatoria para GLP >10 barg. Sin embargo, las opciones Z y G están en el mismo campo del configurador. Confirmar con KROHNE si ambas pueden seleccionarse simultáneamente o si Z ya incluye el burst disk.</div>
    </div>

    <!-- Converter Type -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">13. Tipo de Convertidor</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">Se requiere funcionalidad de CT lock para OIML R117 y salidas de pulsos de alta resolución.</div>
      <div class="param-value">6 — MFC 400 (VE54) Compacto / 7 — MFC 400 (VE54) Campo (según selección en punto 8)</div>
    </div>

    <!-- Functional Safety -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">14. Seguridad Funcional</span>
        <span class="badge badge-fixed">Definido</span>
      </div>
      <div class="param-spec">La especificación no requiere certificación SIL.</div>
      <div class="param-value">0 — Sin SIL</div>
    </div>

  </div>
</div>

<!-- ===== TRANSMISOR ===== -->
<div class="section">
  <div class="section-header" onclick="toggleSection(this)">
    TRANSMISOR — MFC 400 (VE54) <span class="arrow">▼</span>
  </div>
  <div class="section-body">

    <!-- Power -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">15. Alimentación Eléctrica</span>
        <span class="badge badge-decide">Decisión del cliente</span>
      </div>
      <div class="param-spec">Dual: 24 VCC (campo/baterías/vehículo) y 110-220 VCA (laboratorio).</div>
      <div class="param-options" data-field="power">
        <label class="radio-option">
          <input type="radio" name="power" value="1-12-24 VDC" onchange="selectOption(this)">
          <span class="radio-label"><strong>1 — 12-24 VDC</strong><span class="radio-desc">Alimentación de campo. Compatible con baterías y sistema eléctrico del vehículo. Para uso en laboratorio, agregar fuente AC/DC externa (110-220 VAC → 24 VDC).</span></span>
        </label>
        <label class="radio-option">
          <input type="radio" name="power" value="A-100-230 VAC (50/60 Hz)" onchange="selectOption(this)">
          <span class="radio-label"><strong>A — 100-230 VAC (50/60 Hz)</strong><span class="radio-desc">Alimentación de red. Para uso portátil en campo, requeriría inversor DC/AC o generador.</span></span>
        </label>
      </div>
      <div class="note">El MFC 400 acepta una sola fuente. La spec pide dual. Solución recomendada: seleccionar 24 VDC + fuente AC/DC externa para laboratorio. Esto cubre ambos escenarios con mayor flexibilidad.</div>
    </div>

    <!-- Hazardous Area Conv -->
    <div class="param">
      <div class="param-head">
        <span class="param-name">16. Certificación Área Clasificada (Transmisor)</span>
        <span class="badge badge-decide">Decisión del cliente</span>
      </div>
      <div class="param-spec">Debe coincidir con la certificación del sensor (punto 7).</div>
      <div class="param-options" data-field="hazarea_conv">
        <label class="radio-option">
          <input type="radio" name="hazarea_conv" value="1-ATEX Ex zone 1 (d)" onchange="selectOption(this)">
          <span class="radio-label"><strong>1 — ATEX Ex zona 1, compartimento terminal "d" (antideflagrante)</strong></span>
        </label>
        <label class="radio-option">
          <input type="radio" name="hazarea_conv" value="2-ATEX Ex zone 1 (e)" onchange="selectOption(this)">
          <span class="radio-label"><strong>2 — ATEX Ex zona 1, compartimento terminal "e" (seguridad aumentada)</strong></span>
        </label>
        <label class="radio-option">
          <input type="radio" name="hazarea_conv" value="F-IECEx (d)" onchange="selectOption(this)">
          <span class="radio-label"><strong>F — IECEx, compartimento terminal "d" (antideflagrante)</strong></span>
        </label>
        <label class="radio-option">
          <input type="radio" name="hazarea_conv" value="G-IECEx (e)" onchange="selectOption(this)">
          <span class="radio-label"><strong>G — IECEx, compartimento terminal "e" (seguridad aumentada)</strong></span>
        </label>
      </div>
